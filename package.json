{
  "name": "instruct-protocol",
  "version": "0.1.0-alpha.0",
  "description": "Privacy-preserving dual execution protocol for model-directed workflows and sandboxed code",
  "keywords": [
    "ai",
    "agents",
    "sandbox",
    "lua",
    "wasm",
    "capabilities",
    "privacy",
    "protocol"
  ],
  "homepage": "https://github.com/plainIsaac/instruct-protocol#readme",
  "bugs": {
    "url": "https://github.com/plainIsaac/instruct-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainIsaac/instruct-protocol.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "PRODUCTION.md",
    "CHANGELOG.md",
    "spec.md",
    "TOOLRING.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest --reporter=verbose",
    "test:performance": "vitest run test/performance.test.ts --reporter=verbose",
    "test:security": "vitest run test/conformance.test.ts test/production-hardening.test.ts test/production-profile.test.ts test/sandbox.test.ts --reporter=verbose",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "bench:live": "pnpm build && node scripts/live-confidential-benchmark.mjs",
    "bench:warning": "pnpm build && node scripts/live-warning-baseline.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm build",
    "release:check": "pnpm check && pnpm test:security && pnpm audit --prod && pnpm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "tag": "next"
  },
  "dependencies": {
    "wasmoon": "1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
