# Choose openai or openrouter. If omitted, the runner selects the only configured key.
INSTRUCT_BENCH_PROVIDER=openrouter

# Never commit a real key.
OPENROUTER_API_KEY=

# OpenRouter model slug. Override this to compare models.
INSTRUCT_BENCH_MODEL=openai/gpt-5.6
INSTRUCT_BENCH_REASONING=medium

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Instruct Protocol Benchmark
